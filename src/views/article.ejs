<!DOCTYPE html>
<html lang="he" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="theme-color" content="#f5f5f2">
    <title><%= article.title %> — The Daily Web</title>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml">

    <!-- SEO: the full article is in this first HTML, search engines do not need to run any script -->
    <meta name="description" content="<%= article.summary || article.title %>">
    <meta property="og:title" content="<%= article.title %>">
    <meta property="og:description" content="<%= article.summary || article.title %>">
    <meta property="og:image" content="<%= article.mainImage || 'https://images.unsplash.com/photo-1504711434969-e33886168f5c?auto=format&fit=crop&w=1200&q=80' %>">
    <meta property="og:type" content="article">

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Frank+Ruhl+Libre:wght@500;700;900&family=Heebo:wght@400;500;600;700;800&display=swap">
    <link rel="stylesheet" href="/css/base.css">
    <link rel="stylesheet" href="/css/components.css">
    <link rel="stylesheet" href="/css/layout.css">
    <link rel="stylesheet" href="/css/pages.css">
    <script src="/js/theme.js"></script>
    <script src="/js/icons.js"></script>
    <script src="/js/common.js"></script>
    <script src="/js/ui.js"></script>
</head>
<body data-shell="public" data-page="article" data-section="<%= article.category %>">
<script src="/js/shell.js"></script>

<div class="read-progress" aria-hidden="true"><span id="readProgress"></span></div>

<%
    const authorName = (article.author && article.author.fullName) || 'כתב מערכת';
    const wordCount = String(article.content || '').replace(/<[^>]*>/g, ' ').split(/\s+/).filter(Boolean).length;
    const readingMinutes = Math.max(1, Math.round(wordCount / 200));
    const published = new Date(article.publishedAt);
%>

<main class="container article-page" id="main" tabindex="-1">
    <nav class="breadcrumb" aria-label="מיקום באתר">
        <a href="/">ראשי</a>
        <svg class="icon" aria-hidden="true"><use href="#i-chevron-left"></use></svg>
        <a href="/?category=<%= encodeURIComponent(article.category) %>"><%= article.category %></a>
        <span class="weather-chip ms-auto" id="weatherChip" aria-live="polite"></span>
    </nav>

    <article>
        <header class="article-head">
            <a class="tag" href="/?category=<%= encodeURIComponent(article.category) %>"><%= article.category %></a>
            <h1 class="display article-title"><%= article.title %></h1>
            <% if (article.summary) { %>
                <p class="article-summary"><%= article.summary %></p>
            <% } %>
        </header>

        <div class="article-meta">
            <div class="who">
                <span class="avatar" aria-hidden="true"><%= authorName.trim().charAt(0) %></span>
                <div>
                    <strong><%= authorName %></strong>
                    <span>כתב/ת The Daily Web</span>
                </div>
            </div>
            <div class="facts">
                <span><svg class="icon" aria-hidden="true"><use href="#i-calendar"></use></svg>
                    <time datetime="<%= published.toISOString() %>"><%= published.toLocaleDateString('he-IL', { day: 'numeric', month: 'long', year: 'numeric' }) %></time></span>
                <span><svg class="icon" aria-hidden="true"><use href="#i-clock"></use></svg> <%= readingMinutes %> דקות קריאה</span>
            </div>
            <button type="button" class="btn btn-secondary btn-sm ms-auto" data-action="copy-link">
                <svg class="icon" aria-hidden="true"><use href="#i-link"></use></svg> העתקת קישור
            </button>
        </div>

        <figure class="article-cover">
            <img src="<%= article.mainImage || '/images/default-article.svg' %>" alt="<%= article.title %>" width="1200" height="675">
        </figure>

        <div class="prose" id="articleContent">
            <%- article.content %>
        </div>
    </article>

    <div class="article-actions">
        <a class="btn btn-secondary" href="/"><svg class="icon" aria-hidden="true"><use href="#i-arrow-right"></use></svg> חזרה לכל הכתבות</a>
        <a class="btn btn-ghost" href="/?category=<%= encodeURIComponent(article.category) %>">עוד כתבות בנושא <%= article.category %></a>
    </div>

    <!-- Comments: a new comment appears at the top right away, the list is never fetched again -->
    <section class="comments" aria-labelledby="commentsTitle">
        <div class="comments-head">
            <h2 id="commentsTitle">תגובות</h2>
            <span class="badge" id="commentsBadge">0 תגובות</span>
        </div>

        <div id="rateLimitBanner" class="alert alert-warn mb-4" role="alert" hidden>
            <svg class="icon" aria-hidden="true"><use href="#i-hourglass"></use></svg>
            <div><strong>שלחתם יותר מדי תגובות.</strong> אפשר להגיב עד 3 פעמים בדקה. <span id="countdownTimer"></span></div>
        </div>

        <form class="card comment-form" id="commentForm" novalidate>
            <h3 class="h3">הוספת תגובה</h3>
            <div class="field">
                <label class="label" for="commentAuthor">שם <span class="req">*</span></label>
                <input type="text" class="input" id="commentAuthor" maxlength="100" autocomplete="name" required>
            </div>
            <div class="field">
                <label class="label" for="commentContent">התגובה שלכם <span class="req">*</span></label>
                <textarea class="textarea" id="commentContent" rows="3" maxlength="1000" required></textarea>
            </div>
            <div class="field-error" id="commentError" role="alert" hidden></div>
            <div class="comment-form-foot">
                <span class="hint" id="commentCounter">0 / 1000</span>
                <button type="submit" class="btn btn-primary" id="commentSubmitBtn">
                    <svg class="icon" aria-hidden="true"><use href="#i-send"></use></svg> פרסום התגובה
                </button>
            </div>
        </form>

        <div class="comment-list" id="commentsList" aria-live="polite">
            <div class="comment-empty">טוענים תגובות...</div>
        </div>
    </section>

    <section class="related" id="relatedSection" aria-labelledby="relatedTitle" hidden>
        <h2 id="relatedTitle">עוד מהמדור</h2>
        <div class="card-grid" id="relatedGrid"></div>
    </section>
</main>

<script src="/js/comments.js"></script>
<script>
    const articleId = '<%= article._id %>';
    const articleCategory = '<%= article.category %>';
    const COMMENT_LIMIT = 1000;
    let commentCount = 0;
    let countdownTimer = null;

    // Remember that this article was opened (the "seen / not seen" filter on the home page uses it)
    try {
        const viewed = JSON.parse(localStorage.getItem('the_daily_web_viewed') || '[]');
        if (!viewed.includes(articleId)) {
            viewed.push(articleId);
            localStorage.setItem('the_daily_web_viewed', JSON.stringify(viewed.slice(-300)));
        }
    } catch (e) { /* storage unavailable, nothing to remember */ }

    // ---- reading progress -------------------------------------------------------------------
    function updateProgress() {
        const article = document.querySelector('article');
        const rect = article.getBoundingClientRect();
        const total = rect.height - window.innerHeight * 0.6;
        const done = Math.min(1, Math.max(0, -rect.top / Math.max(total, 1)));
        document.getElementById('readProgress').style.width = `${Math.round(done * 100)}%`;
    }
    window.addEventListener('scroll', updateProgress, { passive: true });
    window.addEventListener('resize', updateProgress);

    // ---- copy link ---------------------------------------------------------------------------
    async function copyText(text) {
        try {
            await navigator.clipboard.writeText(text);
            return true;
        } catch (e) {
            // the clipboard API can be blocked (insecure address, no permission): use the old way
            const helper = document.createElement('textarea');
            helper.value = text;
            helper.setAttribute('readonly', '');
            helper.style.cssText = 'position: fixed; opacity: 0; pointer-events: none';
            document.body.appendChild(helper);
            helper.select();
            let copied = false;
            try { copied = document.execCommand('copy'); } catch (err) { copied = false; }
            helper.remove();
            return copied;
        }
    }

    UI.on('copy-link', async () => {
        if (await copyText(window.location.href)) UI.toast('הקישור הועתק');
        else UI.toast('לא הצלחנו להעתיק. אפשר להעתיק את הקישור מסרגל הכתובת.', 'error');
    });

    // ---- comments ----------------------------------------------------------------------------
    function updateCommentsBadge() {
        document.getElementById('commentsBadge').textContent = commentCount === 1 ? 'תגובה אחת' : `${commentCount} תגובות`;
    }

    // Initial load of the list (only once, when the page opens)
    async function loadComments() {
        const listEl = document.getElementById('commentsList');
        try {
            const data = await api('GET', `/api/articles/${articleId}/comments`);
            commentCount = data.pagination.totalCount;
            updateCommentsBadge();
            renderCommentList(listEl, data.comments);
        } catch (err) {
            listEl.innerHTML = UI.stateHtml({ icon: 'triangle-alert', title: 'לא הצלחנו לטעון את התגובות', text: err.message, action: { name: 'retry-comments', label: 'ניסיון חוזר' } });
        }
    }
    UI.on('retry-comments', loadComments);

    function startCountdown(seconds) {
        const banner = document.getElementById('rateLimitBanner');
        const label = document.getElementById('countdownTimer');
        clearInterval(countdownTimer);
        let remaining = seconds;
        banner.hidden = false;
        label.textContent = `אפשר לנסות שוב בעוד ${remaining} שניות.`;
        countdownTimer = setInterval(() => {
            remaining -= 1;
            if (remaining <= 0) {
                clearInterval(countdownTimer);
                banner.hidden = true;
            } else {
                label.textContent = `אפשר לנסות שוב בעוד ${remaining} שניות.`;
            }
        }, 1000);
    }

    const commentForm = document.getElementById('commentForm');
    const commentContent = document.getElementById('commentContent');
    const commentError = document.getElementById('commentError');

    commentContent.addEventListener('input', () => {
        document.getElementById('commentCounter').textContent = `${commentContent.value.length} / ${COMMENT_LIMIT}`;
    });

    commentForm.addEventListener('submit', async (event) => {
        event.preventDefault();
        const authorInput = document.getElementById('commentAuthor');
        const submitBtn = document.getElementById('commentSubmitBtn');
        const authorName = authorInput.value.trim();
        const content = commentContent.value.trim();

        if (!authorName || !content) {
            UI.setMessage(commentError, 'נא למלא שם ותוכן תגובה.');
            (authorName ? commentContent : authorInput).focus();
            return;
        }
        UI.setMessage(commentError, '');

        UI.busy(submitBtn, true);
        try {
            const data = await api('POST', `/api/articles/${articleId}/comments`, { authorName, content });
            document.getElementById('rateLimitBanner').hidden = true;
            commentContent.value = '';
            document.getElementById('commentCounter').textContent = `0 / ${COMMENT_LIMIT}`;
            // the server returns the saved comment: show it at the top right away, no need to reload the list
            addCommentToList(document.getElementById('commentsList'), data.comment);
            commentCount += 1;
            updateCommentsBadge();
            UI.toast('התגובה פורסמה');
        } catch (err) {
            if (err.status === 429) {
                startCountdown((err.data && err.data.retryAfterSeconds) || 60);
            } else {
                UI.setMessage(commentError, err.message);
            }
        } finally {
            UI.busy(submitBtn, false);
        }
    });

    // ---- more from the same section ---------------------------------------------------------
    async function loadRelated() {
        try {
            const data = await api('GET', `/api/articles/public?category=${encodeURIComponent(articleCategory)}&limit=4`);
            const others = data.articles.filter((item) => item._id !== articleId).slice(0, 3);
            if (others.length === 0) return;
            document.getElementById('relatedGrid').innerHTML = others.map((item) => `
                <article class="card card-hover story">
                    <div class="story-media"><img src="${escapeHtml(item.mainImage || FALLBACK_IMAGE)}" alt="" loading="lazy" width="640" height="400"></div>
                    <div class="story-body">
                        <span class="tag">${escapeHtml(item.category)}</span>
                        <h3 class="story-title"><a class="stretched" href="/article/${escapeHtml(item._id)}">${escapeHtml(item.title)}</a></h3>
                        <div class="story-foot">${escapeHtml((item.author && item.author.fullName) || 'כתב המערכת')} · ${escapeHtml(formatDate(item.publishedAt))}</div>
                    </div>
                </article>`).join('');
            document.getElementById('relatedSection').hidden = false;
        } catch (err) { /* related stories are optional */ }
    }

    // Same weather service as the home page (the server caches it for 15 minutes)
    async function showWeather() {
        const weather = await loadWeather();
        if (!weather) return;
        document.getElementById('weatherChip').innerHTML =
            `${icon(weather.icon)} ${escapeHtml(weather.city)} · <span class="num">${escapeHtml(weather.temp)}°</span>${weather.isSample ? ' (נתוני דוגמה)' : ''}`;
    }

    document.addEventListener('DOMContentLoaded', () => {
        updateProgress();
        loadComments();
        loadRelated();
        showWeather();
    });
</script>
</body>
</html>
