<!DOCTYPE html>
<html lang="he" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= article.title %> - The Daily Web</title>
    
    <!-- SEO Meta Tags -->
    <meta name="description" content="<%= article.summary || article.title %>">
    <meta property="og:title" content="<%= article.title %>">
    <meta property="og:description" content="<%= article.summary || article.title %>">
    <meta property="og:image" content="<%= article.mainImage || 'https://images.unsplash.com/photo-1504711434969-e33886168f5c?auto=format&fit=crop&w=1200&q=80' %>">
    <meta property="og:type" content="article">

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Assistant:wght@300;400;500;600;700;800&family=Frank+Ruhl+Libre:wght@700;800;900&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.rtl.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">

    <style>
        :root {
            --font-editorial: 'Frank Ruhl Libre', serif;
            --font-sans: 'Assistant', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
            --news-dark: #121212;
            --news-red: #b91c1c;
        }
        body {
            font-family: var(--font-sans);
            background-color: #f9fafb;
            color: #1f2937;
        }
        .article-header {
            font-family: var(--font-editorial);
            font-size: 2.5rem;
            font-weight: 900;
            line-height: 1.2;
            color: var(--news-dark);
            margin-bottom: 15px;
        }
        .article-content {
            font-size: 1.15rem;
            line-height: 1.8;
        }
        .category-badge {
            font-size: 0.85rem;
            font-weight: 700;
            color: var(--news-red);
            text-transform: uppercase;
        }
        .article-image {
            width: 100%;
            height: auto;
            max-height: 500px;
            object-fit: cover;
            border-radius: 8px;
            margin-bottom: 20px;
        }
        .masthead-title {
            font-family: var(--font-editorial);
            font-size: 2rem;
            font-weight: 900;
            color: var(--news-dark);
            text-decoration: none;
            display: inline-block;
        }
    </style>
</head>
<body>

<nav class="navbar navbar-expand-lg navbar-light bg-white border-bottom shadow-sm">
    <div class="container d-flex justify-content-between align-items-center py-2">
        <a href="/" class="masthead-title">The Daily Web</a>
        <a href="/" class="btn btn-outline-dark btn-sm">חזרה לדף הבית</a>
    </div>
</nav>

<main class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-8 bg-white p-4 p-md-5 rounded shadow-sm">
            <span class="category-badge"><%= article.category %></span>
            <h1 class="article-header mt-2"><%= article.title %></h1>
            
            <div class="d-flex align-items-center text-muted mb-4 pb-3 border-bottom">
                <div class="me-3">
                    <strong><%= article.author ? article.author.fullName : 'כתב מערכת' %></strong>
                </div>
                <div>
                    <i class="bi bi-clock me-1"></i>
                    <%= new Date(article.publishedAt).toLocaleDateString('he-IL') %>
                </div>
            </div>

            <img src="<%= article.mainImage || 'https://images.unsplash.com/photo-1504711434969-e33886168f5c?auto=format&fit=crop&w=1200&q=80' %>" 
                 alt="<%= article.title %>" class="article-image"
                 onerror="this.onerror=null; this.src='https://images.unsplash.com/photo-1504711434969-e33886168f5c?auto=format&fit=crop&w=1200&q=80';">

            <div class="article-content mt-4">
                <%- article.content %>
            </div>
            
            <!-- Comments Section -->
            <div class="mt-5 pt-4 border-top">
                <h4 class="mb-4">תגובות <span class="badge bg-secondary" id="commentsBadge">0 תגובות</span></h4>
                
                <div id="rateLimitBanner" class="alert alert-warning d-none small py-2">
                    <i class="bi bi-exclamation-triangle"></i> אנא המתן לפני שליחת תגובה נוספת. <span id="countdownTimer"></span>
                </div>

                <div class="card mb-4">
                    <div class="card-body">
                        <h6 class="card-title fw-bold">הוספת תגובה</h6>
                        <div class="mb-2">
                            <input type="text" id="commentAuthor" class="form-control form-control-sm" placeholder="שם מלא (חובה)">
                        </div>
                        <div class="mb-2">
                            <textarea id="commentContent" class="form-control form-control-sm" rows="3" placeholder="תוכן התגובה (חובה)"></textarea>
                        </div>
                        <button class="btn btn-dark btn-sm" id="commentSubmitBtn" onclick="submitComment()">
                            <i class="bi bi-send me-1"></i> פרסם תגובה
                        </button>
                    </div>
                </div>

                <div id="commentsList" class="d-flex flex-column gap-2">
                    <div class="text-center text-muted small py-3"><div class="spinner-border spinner-border-sm"></div> טוען תגובות...</div>
                </div>
            </div>

            <hr class="my-5">
            
            <div class="text-center">
                <a href="/" class="btn btn-dark">חזרה לכל הכתבות</a>
            </div>
        </div>
    </div>
</main>

<footer class="bg-dark text-white text-center py-4 mt-5">
    <p class="mb-0 small">© <%= new Date().getFullYear() %> The Daily Web. כל הזכויות שמורות.</p>
</footer>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<script>
    const articleId = '<%= article._id %>';
    
    // Mark article as viewed in localStorage
    try {
        let viewed = JSON.parse(localStorage.getItem('the_daily_web_viewed') || '[]');
        if (!viewed.includes(articleId)) {
            viewed.push(articleId);
            localStorage.setItem('the_daily_web_viewed', JSON.stringify(viewed));
        }
    } catch(e) {}
    
    document.addEventListener('DOMContentLoaded', loadComments);

    function escapeHtml(str) {
        if (!str) return '';
        return String(str)
            .replace(/&/g, '&amp;')
            .replace(/</g, '&lt;')
            .replace(/>/g, '&gt;')
            .replace(/"/g, '&quot;')
            .replace(/'/g, '&#039;');
    }

    async function loadComments() {
        const listEl = document.getElementById('commentsList');
        const badge = document.getElementById('commentsBadge');

        try {
            const res = await fetch(`/api/articles/${articleId}/comments`);
            const data = await res.json();

            if (data.success) {
                badge.textContent = `${data.comments.length} תגובות`;
                if (data.comments.length === 0) {
                    listEl.innerHTML = '<div class="text-center text-muted small py-3">אין עדיין תגובות לכתבה זו. היו הראשונים להגיב!</div>';
                    return;
                }

                listEl.innerHTML = '';
                data.comments.forEach(c => {
                    const item = document.createElement('div');
                    item.className = 'p-3 bg-white rounded border small';
                    const d = new Date(c.createdAt || Date.now());
                    item.innerHTML = `
                        <div class="d-flex justify-content-between text-muted mb-2" style="font-size: 0.8rem;">
                            <strong class="text-primary">${escapeHtml(c.authorName)}</strong>
                            <span>${d.toLocaleDateString('he-IL')} ${d.toLocaleTimeString('he-IL', { hour: '2-digit', minute: '2-digit' })}</span>
                        </div>
                        <div class="text-dark">${escapeHtml(c.content)}</div>
                    `;
                    listEl.appendChild(item);
                });
            }
        } catch (err) {
            listEl.innerHTML = '<div class="text-danger small">שגיאה בטעינת תגובות</div>';
        }
    }

    async function submitComment() {
        const authorInput = document.getElementById('commentAuthor');
        const contentInput = document.getElementById('commentContent');
        const submitBtn = document.getElementById('commentSubmitBtn');
        const banner = document.getElementById('rateLimitBanner');
        const timerSpan = document.getElementById('countdownTimer');

        const authorName = authorInput.value.trim();
        const content = contentInput.value.trim();

        if (!authorName || !content) {
            alert('נא למלא שם מגיב ותוכן תגובה');
            return;
        }

        submitBtn.disabled = true;
        submitBtn.innerHTML = '<span class="spinner-border spinner-border-sm"></span> שולח...';

        try {
            const res = await fetch(`/api/articles/${articleId}/comments`, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ authorName, content })
            });

            const data = await res.json();

            if (res.status === 429) {
                banner.classList.remove('d-none');
                let rem = data.retryAfterSeconds || 60;
                timerSpan.textContent = `(נעילה תשתחרר בעוד ${rem} שניות)`;

                const iv = setInterval(() => {
                    rem--;
                    if (rem <= 0) {
                        clearInterval(iv);
                        banner.classList.add('d-none');
                    } else {
                        timerSpan.textContent = `(נעילה תשתחרר בעוד ${rem} שניות)`;
                    }
                }, 1000);
            } else if (data.success) {
                banner.classList.add('d-none');
                contentInput.value = '';
                await loadComments();
            } else {
                alert(data.message || 'שגיאה בשליחת התגובה');
            }
        } catch (err) {
            alert('שגיאת תקשורת מול השרת');
        } finally {
            submitBtn.disabled = false;
            submitBtn.innerHTML = '<i class="bi bi-send me-1"></i> פרסם תגובה';
        }
    }
</script>
</body>
</html>
