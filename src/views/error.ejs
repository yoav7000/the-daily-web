<!DOCTYPE html>
<html lang="he" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="theme-color" content="#f5f5f2">
    <meta name="robots" content="noindex">
    <title><%= heading %> — The Daily Web</title>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Frank+Ruhl+Libre:wght@500;700;900&family=Heebo:wght@400;500;600;700;800&display=swap">
    <link rel="stylesheet" href="/css/base.css">
    <link rel="stylesheet" href="/css/components.css">
    <link rel="stylesheet" href="/css/layout.css">
    <link rel="stylesheet" href="/css/pages.css">
    <script src="/js/theme.js"></script>
    <script src="/js/icons.js"></script>
    <script src="/js/common.js"></script>
    <script src="/js/ui.js"></script>
</head>
<body data-shell="public" data-page="error">
    <script src="/js/shell.js"></script>

    <main class="container error-page" id="main" tabindex="-1">
        <section class="card error-card">
            <div class="error-code" aria-hidden="true"><%= status %></div>
            <h1><%= heading %></h1>
            <p><%= message %></p>
            <a class="btn btn-primary btn-lg" href="/">חזרה לעמוד הראשי</a>
        </section>
    </main>
</body>
</html>
